# ============================================
# AI English Coach — Exemplo de configuração
# Copie este arquivo para .env e preencha!
# ============================================

# Telegram
TELEGRAM_BOT_TOKEN=

# Groq (LLM + Whisper STT)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Qdrant Cloud (memória vetorial RAG)
VECTOR_DB_TYPE=qdrant
QDRANT_URL=
QDRANT_API_KEY=

# Tavily (busca web)
TAVILY_API_KEY=

# LangSmith (observabilidade — opcional)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=

# Roteador Jev
CONFIANCA_MINIMA_ROUTER=0.6

# AnkiConnect
# Local (padrão): http://localhost:8765
# Anki em outra máquina: http://<IP_DO_ANKI>:8765
# (no Anki: Complementos > AnkiConnect > webCorsOriginList: ["*"])
ANKI_CONNECT_URL=http://localhost:8765
